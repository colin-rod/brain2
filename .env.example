NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Email forwarding via SendGrid Inbound Parse
# Generate with: openssl rand -hex 32
INBOUND_EMAIL_WEBHOOK_SECRET=
# UUID of your Supabase Auth user (Supabase Dashboard → Authentication → Users)
APP_USER_ID=
# Optional: the capture address displayed in Settings (e.g. capture@yourdomain.com)
INBOUND_EMAIL_ADDRESS=
# Your app's public URL (required for the webhook URL display in Settings)
NEXT_PUBLIC_APP_URL=
